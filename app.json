{
  "expo": {
    "name": "Garrys Smartlock and Solar IMS",
    "slug": "garrys-smartlock-solar-ims",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "garrys-ims",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}


